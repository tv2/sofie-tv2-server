{
  "name": "alba-tv2-server",
  "version": "0.0.0",
  "repository": "git@github.com:tv2/alba-tv2-server.git",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "start": "node dist",
    "build": "yarn clean && tsc --build",
    "build-watch": "tsc --build --watch",
    "watch": "nodemon",
    "test": "vitest run --coverage",
    "test-watch": "vitest",
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "validate": "yarn validate-dependencies && yarn validate-licenses",
    "validate-dependencies": "yarn npm audit --environment production --severity moderate --recursive",
    "validate-licenses": "license-checker --production --onlyAllow \"MIT;MIT/X11;BSD;BSD-3-Clause;BSD-2-Clause;ISC;Apache;Apache-2.0;WTFPL;CC-BY-3.0;CC-BY-4.0;CC0-1.0;BlueOak-1.0.0;Unlicense\"",
    "clean": "rimraf dist",
    "reset": "rimraf --glob dist node_modules coverage \"*.log\""
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "devDependencies": {
    "@tv2media/eslint-config": "1.0.3",
    "@types/license-checker": "^25",
    "@types/node": "^22.7.5",
    "@types/ws": "^8.18.1",
    "@typestrong/ts-mockito": "^2.7.12",
    "@vitest/coverage-istanbul": "3.2.4",
    "@vitest/coverage-v8": "^1.5.3",
    "cross-env": "^7.0.3",
    "eslint": "^9.13.0",
    "license-checker": "^25.0.1",
    "nodemon": "^3.1.0",
    "rimraf": "^6.0.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@fastify/http-proxy": "^11.0.1",
    "@fastify/websocket": "^11.0.1",
    "@tv2media/logger": "^2.0.3",
    "atem-connection": "^3.5.0",
    "fastify": "^5.3.2",
    "fastify-type-provider-zod": "^6.0.0",
    "mongodb": "^6.9.1",
    "reflect-metadata": "^0.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "ws": "^8.18.3",
    "zod": "^4.1.5"
  },
  "resolutions": {
    "cross-spawn": ">=7.0.5",
    "@babel/runtime": "^7.27.0"
  }
}
